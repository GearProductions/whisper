{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "app/*": [
        "./src/main/app/*"
      ],
      "core/*": [
        "./src/main/core/*"
      ],
      "helpers/*": [
        "./src/main/helpers/*"
      ],
      "technicals/*": [
        "./src/main/technicals/*"
      ],
      "helpers": [
        "./src/main/helpers"
      ],
      "shared/*": [
        "./src/shared/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "tests",
    "vite.main.config.mts",
    "vitest.config.mts"
  ]
}
