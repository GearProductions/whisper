{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "app/*": [
        "./src/renderer/app/*"
      ],
      "core/*": [
        "./src/renderer/core/*"
      ],
      "helpers/*": [
        "./src/renderer/helpers/*"
      ],
      "technicals/*": [
        "./src/renderer/technicals/*"
      ],
      "helpers": [
        "./src/renderer/helpers"
      ],
      "shared/*": [
        "./src/shared/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/renderer",
    "src/shared",
    "vite.config.mts"
  ]
}
