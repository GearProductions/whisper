# Quadlet : ~/.config/containers/systemd/dev-chatterbox.container
# (cf. chatterbox/README.md). Démarré avec la session ; le modèle n'occupe le
# GPU qu'entre la première lecture et 10 min sans lecture.
[Unit]
Description=Chatterbox TTS sur GPU (lecture à voix haute de whisper-dictation)

[Container]
ContainerName=dev-chatterbox
Image=localhost/dev-chatterbox:latest
AddDevice=nvidia.com/gpu=all
PublishPort=127.0.0.1:8004:8004
# Poids du modèle (~3 Go), régénérables : volume nommé.
Volume=dev-chatterbox-cache:/root/.cache/huggingface
Environment=CHATTERBOX_IDLE_S=600

[Service]
Restart=always

[Install]
WantedBy=default.target
